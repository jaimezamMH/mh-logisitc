# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# base de datos local de desarrollo (SQLite) — ya no se usa, se migró a Postgres
# (Neon), pero se deja el respaldo local por si hace falta consultarlo
/prisma/dev.db
/prisma/dev.db-journal
/prisma/migrations_sqlite_backup

# configuración local de Claude Code (no es parte del proyecto)
/.claude/settings.local.json

# logs del servidor local
*.log

.vercel
.env*
