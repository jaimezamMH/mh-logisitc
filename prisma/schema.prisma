// Esquema de base de datos de MH Logística — Postgres (Neon), tanto en
// desarrollo local como en producción (Vercel); DATABASE_URL apunta a la
// misma base en la nube en los dos casos.

// Se usa el "driver adapter" de Neon (@prisma/adapter-neon) para conectarse
// a la base — así Prisma no depende de un motor nativo (.so.node) que hay
// que empaquetar correctamente para cada plataforma; eso fue justo lo que
// causaba que la app tronara en Vercel ("could not locate the Query Engine")
// aunque localmente sí funcionaba. Con el adapter, la conexión real la hace
// el driver de Neon (JS puro), sin binarios de por medio.
generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Un embarque / unidad que se está moviendo de EUA hacia el cliente en México.
model Shipment {
  id                String   @id @default(cuid())
  folio             String   @unique

  // Identificación del equipo
  semana            Int?
  equipoDescripcion String
  categoria         String?
  tipoUnidad        String?  // CAMION | AMARILLO
  serie             String
  cliente           String
  vendedor          String?  // Jaime Zamudio | Raul Favela | Otro
  fotoUrl           String?  // foto del equipo (data URL, ya comprimida) para identificarlo visualmente
  tipoVenta         String   @default("Equipo") // Equipo | Servicio Logístico (cliente externo, no es equipo propio de MH)

  // Estatus / etapa actual
  estatus           String   @default("Pendiente")

  // Ruta
  origenCiudad      String?
  aduana            String?
  destinoCiudad     String?

  // Proveedores
  proveedorCompra   String?
  provFleteUSA      String?
  provAgenteAduanal String?

  // Costos (MXN o USD según capture el usuario, se define en la UI)
  costoFleteUSA     Float    @default(0)
  costoImportacion  Float    @default(0)
  costoBondCanada   Float    @default(0) // trámite de bond para cruzar de Canadá a USA — se suma a Importación; 0 si no aplica (no es de Canadá)
  costoManiobras    Float    @default(0)
  costoFleteMx      Float    @default(0)
  costoPermiso      Float    @default(0)
  costoSeguro       Float    @default(0)
  costoPlacas       Float    @default(0)
  costoRepuveTitulo Float    @default(0) // Repuve / Título — trámite de registro vehicular
  fleteMexAplica    Boolean  @default(true)

  // Precio cobrado al cliente por cada servicio logístico (solo aplica
  // cuando tipoVenta = "Servicio Logístico"; la diferencia contra el costo
  // real de arriba es la utilidad de ese servicio).
  precioFleteUSA     Float   @default(0)
  precioImportacion  Float   @default(0)
  precioFleteMx      Float   @default(0)
  precioPermiso      Float   @default(0)
  precioSeguro       Float   @default(0)
  precioPlacas       Float   @default(0)

  // Fechas clave del ciclo
  fechaInicio            DateTime? // cuándo se dio de alta / inició el proceso (arranca el "reloj")
  fechaCompra            DateTime?
  fechaSalidaUSA         DateTime?
  fechaCruce             DateTime?
  fechaSalidaProgramada  DateTime? // dispara el recordatorio "hoy sale"
  fechaEntrega           DateTime?
  tiempoCicloDias        Int?
  mesVenta               String?

  documentos        String?
  incidencias       String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  statusEvents   StatusEvent[]
  comments       Comment[]
  paymentOrders  PaymentOrder[]
  sales          Sale[]
  cotizacion     Cotizacion?
  gastosFleteUSA GastoFleteUSA[]
  archivos       Documento[]

  @@index([estatus])
  @@index([fechaSalidaProgramada])
}

// Documento adjunto a una unidad (factura, pedimento, BL, etc.). El archivo
// completo se guarda como data URL (base64) directo en la base, igual que
// fotoUrl — mismo motivo: el proyecto se despliega en Vercel, donde el disco
// no es persistente entre despliegues, así que guardar en la base funciona
// igual en local y en producción sin depender de un servicio externo.
model Documento {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  nombre     String   // etiqueta libre: "Factura", "Pedimento", "BL", etc.
  archivoUrl String   // archivo completo como data URL (base64)
  tipo       String?  // mime type del archivo original (para mostrar ícono / abrir bien)
  createdAt  DateTime @default(now())

  @@index([shipmentId])
}

// Bitácora de cambios de estatus (para el reporte diario/semanal/mensual)
model StatusEvent {
  id              String   @id @default(cuid())
  shipmentId      String
  shipment        Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  estatusAnterior String?
  estatusNuevo    String
  fecha           DateTime @default(now())
  usuario         String?
  comentario      String?

  @@index([shipmentId])
  @@index([fecha])
}

// Orden de pago generada para requisición con administración. shipmentId es
// opcional: si no trae unidad, es una orden "general" (gasto que no se liga
// a ningún equipo en particular — renta de oficina, gastos varios, etc.),
// con su propio desglose en gastosGenerales.
model PaymentOrder {
  id                String    @id @default(cuid())
  folio             String    @unique
  shipmentId        String?
  shipment          Shipment? @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  fechaGenerada     DateTime @default(now())
  generadaPor       String?
  costoFleteUSA     Float
  costoImportacion  Float
  costoManiobras    Float
  costoFleteMx      Float
  costoPermiso      Float
  costoSeguro       Float    @default(0)
  costoPlacas       Float    @default(0)
  costoRepuveTitulo Float    @default(0)
  total             Float
  tipoCambio        Float? // pesos por dólar del día, para ver el total también en MXN
  concepto          String? // qué se está pagando: "Flete USA", "Varios conceptos", etc.
  estatusPago       String   @default("Pendiente") // Pendiente | Pagado | Cancelada
  notas             String?

  // Datos bancarios para hacer el pago (se capturan al generar la orden)
  monedaCuenta      String? // USD | MXN — en qué moneda está la cuenta a la que se paga
  banco             String?
  direccionBanco    String?
  numeroCuenta      String?
  clabe             String?
  titular           String?
  direccionTitular  String?

  // Desglose de los gastos de Flete USA incluidos en esta orden (viáticos,
  // vuelos, comisión, etc. — texto simple "concepto: monto | concepto: monto"
  // para mostrarlo en la orden impresa sin tener que hacer otra consulta).
  detalleFleteUSA   String?
  gastosFleteUSA    GastoFleteUSA[]

  // Desglose de una orden GENERAL (sin unidad) — cada línea es un gasto con
  // su descripción y monto, ej. "Renta de oficina: $5,000", "Gasolina: $800".
  gastosGenerales   GastoGeneral[]

  @@index([shipmentId])
}

// Un gasto dentro de una orden de pago GENERAL (concepto "Otros" — no ligada
// a ningún equipo). Permite desglosar de qué se compone el monto total.
model GastoGeneral {
  id             String       @id @default(cuid())
  paymentOrderId String
  paymentOrder   PaymentOrder @relation(fields: [paymentOrderId], references: [id], onDelete: Cascade)
  descripcion    String
  monto          Float
  createdAt      DateTime     @default(now())

  @@index([paymentOrderId])
}

// Un gasto individual que compone el costo de Flete USA de una unidad (no es
// un solo viaje — son varios conceptos que se van sumando: viáticos, vuelos,
// gastos generales, comisión, etc.). El total de estos gastos es lo que se
// guarda en Shipment.costoFleteUSA. Cuando se incluye en una orden de pago,
// queda ligado a esa orden (paymentOrderId) para no volver a incluirlo dos
// veces por accidente.
model GastoFleteUSA {
  id             String        @id @default(cuid())
  shipmentId     String
  shipment       Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  concepto       String
  monto          Float
  fecha          DateTime      @default(now())
  paymentOrderId String?
  paymentOrder   PaymentOrder? @relation(fields: [paymentOrderId], references: [id])
  createdAt      DateTime      @default(now())

  @@index([shipmentId])
  @@index([paymentOrderId])
}

// Ventas / ciclo de venta. Puede o no estar ligada a un embarque específico
// (los registros históricos importados del PDF no tienen ese vínculo confirmado).
model Sale {
  id              String    @id @default(cuid())
  shipmentId      String?
  shipment        Shipment? @relation(fields: [shipmentId], references: [id])
  vendedor        String
  comprador       String?
  tipoUnidad      String?   // CAMION | AMARILLO
  tiempoCicloDias Int?
  fecha           DateTime?
  mes             String?
  anio            Int?
  fleteMex        Boolean   @default(true)
  origenDato      String    @default("app") // app | historico-pdf
  createdAt       DateTime  @default(now())

  @@index([mes])
  @@index([vendedor])
}

// Cotización enviada a un cliente (prospecto de venta todavía no confirmada).
// Si el cliente la acepta, se convierte en una unidad real (Shipment) y
// queda ligada aquí via shipmentId.
model Cotizacion {
  id                String   @id @default(cuid())
  folio             String   @unique
  fecha             DateTime @default(now())

  cliente           String
  tipoMaquina       String
  anio              String?
  origenCiudad      String?
  destinoCiudad     String?
  fotoUrl           String?
  vendedor          String?

  costoFleteUSA     Float    @default(0)
  costoImportacion  Float    @default(0)
  costoManiobras    Float    @default(0)
  costoFleteMx      Float    @default(0)
  costoPermiso      Float    @default(0)
  ivaPorcentaje     Float    @default(0) // 0 = no se cobra IVA en esta cotización

  estatus           String   @default("Pendiente") // Pendiente | Aceptada | Rechazada

  shipmentId        String?  @unique
  shipment          Shipment? @relation(fields: [shipmentId], references: [id])

  createdAt         DateTime @default(now())

  @@index([estatus])
}

// Historial de costos por proveedor (tabla del PDF sin vínculo confirmado a
// un embarque específico). Sirve para analítica de proveedores y rendimientos.
model CostoHistorico {
  id                String   @id @default(cuid())
  proveedorCompra   String?
  provFleteUSA      String?
  provAgenteAduanal String?
  costoFleteUSA     Float    @default(0)
  costoImportacion  Float    @default(0)
  costoFleteMx      Float    @default(0)
  createdAt         DateTime @default(now())
}

// Comentarios y recordatorios (ej. recordatorio de salida del día)
model Comment {
  id                String    @id @default(cuid())
  shipmentId        String?
  shipment          Shipment? @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  fecha             DateTime  @default(now())
  fechaRecordatorio DateTime?
  texto             String
  tipo              String    @default("comentario") // comentario | recordatorio
  autor             String?
  resuelto          Boolean   @default(false)
  createdAt         DateTime  @default(now())

  @@index([shipmentId])
  @@index([fechaRecordatorio])
}
