# Copia este archivo a .env.local y llena los valores. Nunca subas las
# llaves reales al repo; en Vercel van en Settings → Environment Variables.

# Base de datos (Neon)
DATABASE_URL=

# Claves de acceso a la app
APP_PASSWORD=
APP_PASSWORD_VIEW=
# Opcional: llave para firmar la cookie de sesión. Si no se define se usa
# APP_PASSWORD. Cambiarla cierra todas las sesiones abiertas.
AUTH_SECRET=

# ERP (pruebas: https://mhdev.posix.mx — producción usa otra URL y otras llaves)
ERP_URL=
ERP_API_KEY=
ERP_API_SECRET=

# Token que el ERP manda en "Authorization: Bearer ..." al llamar
# /api/erp/unidades y /api/erp/ordenes-pago/estatus. 32+ caracteres
# aleatorios; se genera con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MH_LOGISTICA_TOKEN=
